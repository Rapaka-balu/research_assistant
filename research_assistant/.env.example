# ── LLM ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile     # or mixtral-8x7b-32768, llama-3.1-8b-instant

# ── Memory ───────────────────────────────────────────
CHECKPOINT_DB_PATH=./memory/checkpoints.db

# ── Search ───────────────────────────────────────────
MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10

# ── Evals ────────────────────────────────────────────
# RAGAS uses OpenAI by default for its judge model.
# Set this to use a local/free judge instead (optional).
RAGAS_JUDGE_MODEL=llama-3.3-70b-versatile
